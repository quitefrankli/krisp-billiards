[settings]
os=Linux
arch=x86_64
compiler=clang
compiler.version=17
compiler.libcxx=libstdc++11
compiler.cppstd=20
# Projects and Krisp are Debug; third-party dependencies remain Release.
build_type=Debug
*:build_type=Release
krisp/*:build_type=Debug

[conf]
tools.build:compiler_executables={"c": "/usr/bin/clang-17", "cpp": "/usr/bin/clang++-17"}
tools.cmake.cmaketoolchain:generator=Ninja
tools.build:jobs=6
